# Blocks are discovered with ServiceLoader (generated by @AutoService).
-keep class * extends com.daisychain.engine.spec.ActionDefinition { <init>(); }
-keepnames class com.daisychain.engine.spec.ActionDefinition

# kotlinx.serialization
-keepattributes *Annotation*, InnerClasses, Signature
-keep,includedescriptorclasses class com.daisychain.**$$serializer { *; }
-keepclassmembers class com.daisychain.** { *** Companion; }
-keepclasseswithmembers class com.daisychain.** { kotlinx.serialization.KSerializer serializer(...); }

# Shizuku is called through reflection (newProcess)
-keep class rikka.shizuku.** { *; }

# Plugins and imports read org.json
-dontwarn org.json.**
